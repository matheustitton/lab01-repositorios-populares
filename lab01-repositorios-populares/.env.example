# Copie para .env e preencha. O .env nao vai para o repositorio.

# Personal Access Token do GitHub (escopo public_repo basta para a Parte 1;
# para o snapshot do Projects v2 e necessario tambem o escopo read:project).
GITHUB_TOKEN=

# Opcionais - ha default para todos em src/config/settings.py
# GITHUB_GRAPHQL_URL=https://api.github.com/graphql
# Nao aumente PAGE_SIZE sem necessidade: acima de 10 a API passa a responder 502 nos
# repositorios maiores, porque cada um pede quatro totalCount agregados.
# PAGE_SIZE=10
# TARGET_COUNT=1000
# REQUEST_TIMEOUT=60

# Necessarios apenas para o snapshot do board (Parte 2, item 6).
# O numero esta na URL do board: github.com/users/<owner>/projects/<numero>
# Tambem podem ser passados por --owner e --number na linha de comando.
# PROJECT_OWNER=matheustitton
# PROJECT_NUMBER=2
